# Used by `alchemy deploy` / `alchemy plan`.
# Cloudflare OAuth: `npm run login:alchemy` → ~/.alchemy/profiles.json

# Zone on this Cloudflare account (currently codetek.us)
CLOUDFLARE_ZONE_ID=your-zone-id

INBOX_HOSTNAME=agent-inbox.codetek.us
MAIL_DOMAIN=agent-inbox.codetek.us

# From Access app after first deploy (Worker → Domains → Access modal, or alchemy state export)
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Inbound routing + outbound sending for MAIL_DOMAIN
ENABLE_EMAIL_ROUTING=true
